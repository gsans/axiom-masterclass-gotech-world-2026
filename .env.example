# Paste your key from https://aistudio.google.com/apikey (separate from your Antigravity login)
GEMINI_API_KEY="your-api-key-here"

# Model for the labs. Keep exactly one GEMINI_MODEL line uncommented.

# Gemini 4 Argon (not available on free-tier API keys)
# GEMINI_MODEL="gemini-4-argon"

# Gemini 3.8 Flash (recommended)
GEMINI_MODEL="gemini-3.8-flash"

# Gemini 3.5 Flash Lite
# GEMINI_MODEL="gemini-3.5-flash-lite"
