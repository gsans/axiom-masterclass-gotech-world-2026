# Target Git repository (defaults to ./sample-repo; labs never touch company code)
TARGET_REPO_PATH=./sample-repo

# API Keys for Live Mode (PoC also includes a built-in Simulation/Dry-Run fallback if keys are omitted)
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-proj-...
OPENROUTER_API_KEY=sk-or-...
GOOGLE_API_KEY=your-google-api-key
GEMINI_LIVE_MODEL=gemini-3.8-flash-live-preview
GEMINI_LIVE_FALLBACK_MODEL=gemini-3.1-flash-live-preview
GEMINI_INTERACTIONS_MODEL=gemini-3.8-flash

# Optional Server & Model Configuration
PORT=8000
# Independent judge (required for live review; no cheap default). Set to a current Codex/OpenAI model.
CODEX_MODEL=
AXIOM_ALLOW_DEGRADED_JUDGE=0

# ============================================================================
# 🎩 TRAINER / CTO "MAGICIAN TOOLBOX" FEATURE FLAGS (Marketing & Stage Presets)
# Set AXIOM_STAGE_UNLOCK=0 before publishing the public student starter repo
# to hide the CTO Toolbox drawer unless unlocked via secret env/header.
# ============================================================================
AXIOM_STAGE_UNLOCK=1
AXIOM_ENABLE_DETERMINISTIC_ORACLES=1
AXIOM_ENABLE_GATEWAY_SWITCH=1
AXIOM_ENABLE_SPONSOR_CHASSIS=1
AXIOM_ENABLE_REDTEAM_CHAOS=1
AXIOM_ENABLE_TOKEN_WEATHER=1
AXIOM_HARD_BUDGET_USD=0.50
AXIOM_GATEWAY_MODE=CLOUD_PRIMARY
AXIOM_SPONSOR_PRESET=DEFAULT_CLAUDE_CODEX

# Layer 2 Transport & Key-Vaulting Pipe (pxpipe / Local Egress Proxy under OpenRouter)
# Agents inside worktrees receive only ephemeral tokens + PXPIPE_LOCAL_PROXY_URL,
# keeping raw vendor keys out of agent subprocess memory and enabling P2P GPU tunneling.
AXIOM_ENABLE_PXPIPE_PROXY=1
PXPIPE_LOCAL_PROXY_URL=http://127.0.0.1:8088/v1
PXPIPE_AIRGAP_TUNNEL_NODE=pxpipe://mac-studio-cluster.local:8088/v1
